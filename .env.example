# Copy to .env on the Pi Zero 2W and adjust to match your I2S card.
# List devices:  arecord -l  (capture)  and  aplay -l  (playback)
#
# Unlike the Pi 5 (USB cards), the Zero 2W uses a GPIO I2S mic + I2S class-D
# amp. With a single I2S sound card (e.g. googlevoicehat-soundcard overlay),
# capture and playback are usually the SAME card number. Confirm with -l.

# I2S microphone. Like the output, this is a plugin chain from
# config/asoundrc.softvol, not the raw card: ALSA selects the mic's channel
# and applies the mic gain. Point it back at plughw:0,0 to run without that
# file -- capture then gets a halved, downmixed signal at a fixed gain.
AUDIO_INPUT_DEVICE=mic_in

# The mic gain control, and a silent PCM used to create it on a fresh boot.
# Both must match config/asoundrc.softvol. AUDIO_MIC_MIXER_CARD is only
# needed if capture and playback are on different cards; it defaults to
# AUDIO_MIXER_CARD below.
AUDIO_MIC_MIXER_CONTROL=Mic Capture Volume
AUDIO_MIC_MIXER_PRIME_DEVICE=mic_prime

# I2S class-D amp / speaker. This is the `softvol` plugin from
# config/asoundrc.softvol (install it as ~/.asoundrc), NOT the raw card:
# playback volume is applied by ALSA, not in Python. Without that file
# installed, aplay will fail with "No such device" -- point this back at
# plughw:0,0 to run without it (the volume slider then does nothing).
AUDIO_OUTPUT_DEVICE=softvol_out

# The mixer control softvol creates, and a silent PCM used to create it on a
# fresh boot. Both must match config/asoundrc.softvol. The card can be a
# number or a name (`aplay -l`); a name survives renumbering.
AUDIO_MIXER_CARD=sndrpigooglevoi
AUDIO_MIXER_CONTROL=PCM Playback Volume
AUDIO_MIXER_PRIME_DEVICE=softvol_prime

# Mic calibration at session start: quiet period, then speaker says "Say hello to start"
CALIBRATION_QUIET_SEC=1.0
CALIBRATION_SPEAK_SEC=5.0

# Mic make-up gain. The mic's raw signal is quiet by hardware design (fixed
# sensitivity), so gain is applied as a steady multiplier -- not per-chunk
# normalization, which would pump the noise floor between words. Applied by
# ALSA (the Mic Capture Volume control above), converted from this multiplier
# to a dB step; the useful range is 0 to 50. Peaks past full scale saturate
# rather than wrap.
#
# Like PLAYBACK_GAIN this is only the STARTUP FALLBACK -- the app's
# remembered mic slider wins if HELLO_ACK carries one.
#
# Start at 1.0 and raise gradually; verify with:
#   python audio-diagnostic equivalent: record, check for clipping, repeat.
INPUT_GAIN=1.0

# 0.35 was the comfortable level found during manual SoX testing with this
# speaker/amp combination. Treat it as a starting point for THIS hardware,
# not a universal value -- raise or lower by ear.
#
# This is only the STARTUP FALLBACK. If the app sends a volume in HELLO_ACK
# the device adopts that instead, since the app remembers what the user set.
# The device also reports this value's slider equivalent in HELLO so the app
# can show its slider where the hardware actually is.
#
# Note the units differ: this is a raw amplitude multiplier, while the slider
# is 0-100 with a square-law taper (see volume_percent_to_gain). 0.35 here is
# slider ~59%; to pick a value from a slider position, square it (60% -> 0.36).
# The multiplier is converted to a softvol step (gain_to_softvol_index) and
# applied by ALSA; values above 1.0 are meaningless, since softvol attenuates
# and cannot boost.
PLAYBACK_GAIN=0.35
